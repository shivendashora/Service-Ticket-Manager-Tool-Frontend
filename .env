VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-auth-domain
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-storage-bucket
VITE_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
VITE_FIREBASE_APP_ID=your-app-id

# ---------------------------------------------------------
# BACKEND URL: keep exactly ONE VITE_API_URL uncommented
# ---------------------------------------------------------

# Local development: Vite proxies /api to BACKEND_URL below (see vite.config.js)
VITE_API_URL=/api

# Deployed FastAPI backend (PostgreSQL)
# VITE_API_URL=https://your-fastapi-backend.onrender.com

# Deployed Flask backend (Supabase)
# VITE_API_URL=https://your-flask-backend.onrender.com

# ---------------------------------------------------------
# LOCAL PROXY TARGET for VITE_API_URL=/api: keep exactly ONE uncommented
# ---------------------------------------------------------

# FastAPI (uvicorn main:app --port 8000)
BACKEND_URL=http://localhost:8000

# Flask (python app.py, port 5000)
# BACKEND_URL=http://localhost:5000
